<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Widget.App.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/input_stroke</item>
        <item name="hintEnabled">false</item>
        <item name="errorIconDrawable">@null</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>

    <style name="Widget.App.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">15sp</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="Widget.App.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">15sp</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="Widget.App.Button.Danger" parent="Widget.App.Button.Outlined">
        <item name="android:textColor">?attr/colorError</item>
        <item name="strokeColor">?attr/colorError</item>
        <item name="rippleColor">?attr/colorErrorContainer</item>
    </style>

    <style name="Widget.App.Toolbar" parent="Widget.Material3.Toolbar.Surface">
        <item name="android:background">?attr/colorSurface</item>
        <item name="titleTextAppearance">@style/TextAppearance.App.ToolbarTitle</item>
        <item name="titleTextColor">?attr/colorOnSurface</item>
        <item name="navigationIconTint">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.App.ToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.App.Headline" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">serif</item>
        <item name="fontFamily">serif</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.App.Overline" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="TextAppearance.App.Price" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <style name="TextAppearance.App.Chip" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/tint_teal_deep</item>
    </style>

    <style name="Widget.App.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/c_card</item>
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.App.Card.Tonal" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">?attr/colorSecondaryContainer</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <style name="ShapeAppearance.App.Image" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.App.Circle" parent="ShapeAppearance.Material3.Corner.Full" />

    <style name="TextAppearance.App.NavLabel" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">@dimen/nav_label_size</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="TextAppearance.App.NavLabel.Active">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.App.NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/nav_indicator</item>
        <item name="android:width">76dp</item>
        <item name="android:height">52dp</item>
    </style>

    <style name="TextAppearance.App.OnHero.Headline" parent="TextAppearance.App.Headline">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">34sp</item>
    </style>

    <style name="TextAppearance.App.OnHero.Overline" parent="TextAppearance.App.Overline">
        <item name="android:textColor">@color/on_hero_muted</item>
    </style>

    <style name="TextAppearance.App.OnHero.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/on_hero_muted</item>
    </style>

    <style name="Widget.App.Toolbar.Transparent" parent="Widget.App.Toolbar">
        <item name="android:background">@android:color/transparent</item>
    </style>

    <style name="Widget.App.Button.OnHero" parent="Widget.App.Button">
        <item name="backgroundTint">@color/white</item>
        <item name="android:textColor">@color/hero</item>
    </style>

    <style name="Widget.App.Button.OutlineOnHero" parent="Widget.App.Button.Outlined">
        <item name="android:textColor">@color/white</item>
        <item name="strokeColor">@color/white</item>
        <item name="rippleColor">@color/ghost_on_hero</item>
    </style>

    <style name="Widget.App.Button.CircleOnHero" parent="Widget.Material3.Button.IconButton.Filled">
        <item name="backgroundTint">@color/ghost_on_hero</item>
        <item name="iconTint">@color/white</item>
    </style>

    <style name="Widget.App.Button.CircleCard" parent="Widget.Material3.Button.IconButton.Filled">
        <item name="backgroundTint">@color/c_card</item>
        <item name="iconTint">?attr/colorOnSurface</item>
    </style>

    <style name="ShapeAppearance.App.BottomRounded" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">0dp</item>
        <item name="cornerSizeTopRight">0dp</item>
        <item name="cornerSizeBottomLeft">36dp</item>
        <item name="cornerSizeBottomRight">36dp</item>
    </style>

    <style name="Widget.App.HeroCard" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/hero</item>
        <item name="cardElevation">0dp</item>
        <item name="cardCornerRadius">0dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.BottomRounded</item>
        <item name="shapeAppearanceOverlay">@null</item>
    </style>
</resources>
